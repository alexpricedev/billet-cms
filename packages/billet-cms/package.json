{
  "name": "@alexpricedev/billet-cms",
  "version": "0.1.1",
  "description": "Block plugin and contract for Billet CMS",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./fields": "./src/fields/index.ts",
    "./handoff": "./src/handoff/index.ts",
    "./preview": "./src/preview/index.ts",
    "./sign-in": "./src/sign-in/index.ts",
    "./server": "./src/server/index.ts",
    "./schema": "./src/schema/index.ts",
    "./cli/publish": "./src/cli/publish/index.ts",
    "./cli/pull": "./src/cli/pull/index.ts"
  },
  "bin": {
    "billet-cms-publish": "./src/cli/publish/cli.ts",
    "billet-cms-pull": "./src/cli/pull/cli.ts"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.ts",
    "!src/**/fixtures"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "license": "MIT",
  "author": "Alex Price",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpricedev/billet-cms.git"
  },
  "bugs": {
    "url": "https://github.com/alexpricedev/billet-cms/issues"
  },
  "homepage": "https://github.com/alexpricedev/billet-cms#readme",
  "keywords": [
    "billet",
    "cms",
    "headless",
    "blocks",
    "bun"
  ],
  "scripts": {
    "lint": "biome check src",
    "lint:write": "biome check src --write",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test src",
    "check": "bun run lint && bun run typecheck"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
