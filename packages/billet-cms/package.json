{
  "name": "@alexpricedev/billet-cms",
  "version": "0.0.0",
  "description": "Block plugin and contract for Billet CMS",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract/index.ts",
    "./fields": "./src/fields/index.ts",
    "./handoff": "./src/handoff/index.ts",
    "./sign-in": "./src/sign-in/index.ts",
    "./schema": "./src/schema/index.ts",
    "./cli/publish": "./src/cli/publish/index.ts"
  },
  "bin": {
    "billet-cms-publish": "./src/cli/publish/cli.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "biome check src",
    "lint:write": "biome check src --write",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test src",
    "check": "bun run lint && bun run typecheck"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "^7.0.2",
    "zod": "^4.0.0"
  }
}
